# Download the Electron binary from a mirror so `npm install` does not fail behind
# networks where @electron/get's direct GitHub fetch is blocked (the cause of the
# "Electron uninstall" / "fetch failed" error when running `npm run watch`).
# If this mirror is also unreachable, use a corporate proxy instead, e.g.:
#   ELECTRON_GET_USE_PROXY=1 GLOBAL_AGENT_HTTPS_PROXY=http://<proxy>:<port> npm install
#electron_mirror=https://npmmirror.com/mirrors/electron/
strict-ssl=false
