{
    "name": "checkout-proxy",
    "version": "1.7.1",
    "description": "HTTPS Proxy with dynamic certificate generation and host mapping",
    "main": "./out/main/main.js",
    "scripts": {
        "start": "electron-vite dev --sourcemap --remote-debugging-port=9222",
        "watch": "electron-vite dev --watch --sourcemap --remote-debugging-port=9222",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder",
        "dist:win-mac": "NODE_TLS_REJECT_UNAUTHORIZED=0 npm run build && electron-builder --mac --win --publish never && node ./script/post-package.js",
        "dist:mac-test": "NODE_TLS_REJECT_UNAUTHORIZED=0 npm run build && electron-builder --mac --publish never",
        "icons": "node ./script/generate-icons.js --iconset",
        "test": "jest",
        "format": "prettier --write .",
        "perf": "node ./test/load-test.mjs",
        "postinstall": "node -e \"const f='node_modules/electron/install.js'; require('fs').existsSync(f) && require('child_process').execFileSync(process.execPath,[f],{stdio:'inherit'})\""
    },
    "author": "sunjaieks",
    "license": "GPL-3.0",
    "dependencies": {
        "@babel/parser": "^7.28.3",
        "@vscode/sudo-prompt": "^9.3.1",
        "electron-store": "^11.0.2",
        "iconv-lite": "^0.7.2",
        "node-forge": "^1.3.3",
        "socks": "^2.8.9",
        "terser": "^5.43.1"
    },
    "devDependencies": {
        "@babel/core": "^7.28.6",
        "@babel/preset-env": "^7.28.6",
        "ace-builds": "^1.43.2",
        "babel-jest": "^30.2.0",
        "electron": "^44.4.5",
        "electron-builder": "^26.0.12",
        "electron-vite": "^5.0.0",
        "jest": "^30.2.0",
        "playwright": "^1.61.0",
        "prettier": "^3.3.3",
        "vite": "^6.3.5"
    },
    "build": {
        "afterPack": "./script/after-pack.js",
        "appId": "sunjaieks.checkoutproxy",
        "productName": "CheckoutProxy",
        "executableName": "CheckoutProxy",
        "artifactName": "CheckoutProxy-${version}-${arch}.${ext}",
        "files": [
            "out/**/*"
        ],
        "extraResources": [
            {
                "from": "resources",
                "to": "resources",
                "filter": [
                    "!favicon.ico",
                    "!icon.icns",
                    "!fallback_ca.cnf",
                    "!root_ca.cnf",
                    "!root_ca.crt",
                    "!root_ca.key"
                ]
            },
            {
                "from": "README.md",
                "to": "README.md"
            }
        ],
        "directories": {
            "buildResources": "resources",
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "resources/favicon.ico"
        },
        "mac": {
            "entitlements": "entitlements.mac.plist",
            "entitlementsInherit": "entitlements.mac.plist",
            "extendInfo": {
                "NSLocalNetworkUsageDescription": "This app requires local network access to run a proxy server on your machine."
            },
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "icon": "resources/icon.icns",
            "category": "public.app-category.developer-tools",
            "identity": null
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "engines": {
        "node": "24.21.0",
        "npm": "11.19.0"
    }
}
